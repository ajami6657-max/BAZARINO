generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  displayName  String?
  username     String?  @unique
  countryCode  String   @default("IR")
  locale       String   @default("fa-IR")
  role         UserRole @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  listings     Listing[]
  store        Store?
  @@index([countryCode, status])
}
model Store {
  id          String   @id @default(uuid())
  ownerId     String   @unique
  name        String
  description String?
  countryCode String
  defaultCurrency String @default("USD")
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerId], references: [id])
  listings    Listing[]
}
model Listing {
  id          String @id @default(uuid())
  sellerId    String
  storeId     String?
  title       String
  description String
  price       Decimal @db.Decimal(18, 4)
  currency    String @default("USD")
  countryCode String
  locale      String @default("en")
  category    String
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  seller      User @relation(fields: [sellerId], references: [id])
  store       Store? @relation(fields: [storeId], references: [id])
  @@index([countryCode, category, status])
  @@index([currency, price])
}
model Order {
  id          String @id @default(uuid())
  buyerId     String
  sellerId    String
  countryCode String
  currency    String
  subtotal    Decimal @db.Decimal(18, 4)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime @default(now())
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}
model AiTask {
  id          String @id @default(uuid())
  taskType    String
  status      AiTaskStatus @default(QUEUED)
  inputJson   Json
  outputJson  Json?
  needsReview Boolean @default(true)
  createdAt   DateTime @default(now())
  completedAt DateTime?
  @@index([status, createdAt])
}
enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum AiTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  REVIEW_REQUIRED
}
