generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  displayName  String?
  username     String?  @unique
  countryCode  String   @default("IR")
  locale       String   @default("fa-IR")
  role         UserRole @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  listings     Listing[]
  buyerOrders  Order[] @relation("OrderBuyer")
  sellerOrders Order[] @relation("OrderSeller")
  store        Store?
  buyerPayments Payment[] @relation("PaymentBuyer")
  sellerPayments Payment[] @relation("PaymentSeller")
  payoutAccounts SellerPayoutAccount[]
  payouts      SellerPayout[]
  @@index([countryCode, status])
}
model Store {
  id          String   @id @default(uuid())
  ownerId     String   @unique
  name        String
  description String?
  countryCode String
  defaultCurrency String @default("USD")
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerId], references: [id])
  listings    Listing[]
}
model Listing {
  id          String @id @default(uuid())
  sellerId    String
  storeId     String?
  title       String
  description String
  price       Decimal @db.Decimal(18, 4)
  currency    String @default("USD")
  countryCode String
  locale      String @default("en")
  category    String
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  seller      User @relation(fields: [sellerId], references: [id])
  store       Store? @relation(fields: [storeId], references: [id])
  @@index([countryCode, category, status])
  orders      Order[]
  @@index([currency, price])
}
model Order {
  id          String @id @default(uuid())
  buyerId     String
  sellerId    String
  listingId   String
  quantity    Int @default(1)
  countryCode String
  currency    String
  subtotal    Decimal @db.Decimal(18, 4)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime @default(now())
  payment     Payment?
  buyer       User @relation("OrderBuyer", fields: [buyerId], references: [id])
  seller      User @relation("OrderSeller", fields: [sellerId], references: [id])
  listing     Listing @relation(fields: [listingId], references: [id])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}
model Payment {
  id                String @id @default(uuid())
  orderId           String @unique
  buyerId           String
  sellerId          String
  gatewayCode       String
  providerPaymentId String? @unique
  idempotencyKey    String @unique
  currency          String
  grossAmount       Decimal @db.Decimal(18, 4)
  commissionBps     Int @default(50)
  platformFee       Decimal @db.Decimal(18, 4)
  sellerNet         Decimal @db.Decimal(18, 4)
  status            PaymentStatus @default(INITIATED)
  checkoutUrl       String?
  providerMetadata  Json?
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order @relation(fields: [orderId], references: [id])
  buyer             User @relation("PaymentBuyer", fields: [buyerId], references: [id])
  seller            User @relation("PaymentSeller", fields: [sellerId], references: [id])
  payouts           SellerPayout[]
  @@index([sellerId, status, createdAt])
  @@index([buyerId, createdAt])
}
model SellerPayoutAccount {
  id                    String @id @default(uuid())
  sellerId              String
  providerCode           String
  providerBeneficiaryId  String
  accountLast4           String?
  currency               String
  countryCode            String
  isDefault              Boolean @default(false)
  verifiedAt             DateTime?
  createdAt              DateTime @default(now())
  seller                 User @relation(fields: [sellerId], references: [id])
  payouts                SellerPayout[]
  @@unique([sellerId, providerCode, providerBeneficiaryId])
  @@index([sellerId, isDefault])
}
model SellerPayout {
  id             String @id @default(uuid())
  paymentId      String
  sellerId       String
  payoutAccountId String
  amount         Decimal @db.Decimal(18, 4)
  currency       String
  providerRef    String? @unique
  status         PayoutStatus @default(PENDING)
  failureReason  String?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  payment        Payment @relation(fields: [paymentId], references: [id])
  seller         User @relation(fields: [sellerId], references: [id])
  payoutAccount  SellerPayoutAccount @relation(fields: [payoutAccountId], references: [id])
  @@index([sellerId, status, createdAt])
}

model AiTask {
  id          String @id @default(uuid())
  taskType    String
  status      AiTaskStatus @default(QUEUED)
  inputJson   Json
  outputJson  Json?
  needsReview Boolean @default(true)
  createdAt   DateTime @default(now())
  completedAt DateTime?
  @@index([status, createdAt])
}
enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}
enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}
enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}
enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}
enum AiTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  REVIEW_REQUIRED
}
